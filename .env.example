# Optional — PlanForge loads this from the repo root when present.

# --- Optional: Ollama normalization (both required together; set model here, not in code) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:latest
#
# Sheet uploads: default stays heuristic-only (precision). Optional LLM assist:
# PLANFORGE_SHEET_NORMALIZE_MODE=heuristic_only   # default — no LLM on sheets
# PLANFORGE_SHEET_NORMALIZE_MODE=llm_labels_only   # Ollama/HTTP: names & labels only, merged onto heuristic
# PLANFORGE_SHEET_NORMALIZE_MODE=llm_merge   # full LLM layout accepted only if gates pass vs heuristic (experimental)
#
# Image/CAD: when Ollama or HTTP LLM returns a layout, it is compared to heuristic; rejected layouts fall back.

# --- OpenAI (select "openai" in Studio → AI Model to activate) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Gemini (select "gemini" in Studio → AI Model to activate) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Optional: OpenAI-compatible HTTP LLM (generic fallback) ---
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Pipeline (scripts/run_pipeline.sh) ---
# PLANFORGE_API_BASE_URL=http://127.0.0.1:8000
# PLANFORGE_INPUT_FILE=./samples/retail_dummy_dimensions.xlsx   # image, DXF, Excel, PDF, unified CSV (sheet/_sheet column), or ZIP of CSVs
# PLANFORGE_INPUT_TYPE=sheet   # optional: image | sheet | cad — omitted = infer from extension
# PLANFORGE_PIPELINE_OUTPUT_DIR=./pipeline_output
# PLANFORGE_PROJECT_NAME="My layout"
# PLANFORGE_REFERENCE_PLAN_IMAGE=./samples/your_floor_plan.png   # optional faint underlay behind sheet SVG

# --- Optional: OpenAPI servers entry ---
# PUBLIC_API_URL=

# --- Storage ---
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
# LOG_LEVEL=INFO

# --- Image OCR ---
# TESSERACT_CMD=/usr/bin/tesseract
